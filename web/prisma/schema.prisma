// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "./generated/client"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

// =====================
// Reviseo core models
// =====================

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum FeedbackType {
  BUG
  IMPROVEMENT
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Website {
  id        String @id @default(cuid())
  name      String
  url       String @unique
  projectId String @unique @default(uuid())

  widgetInstalled Boolean   @default(false)
  verifiedAt      DateTime?

  screenshotKey String?

  developerId String
  developer   User   @relation("DeveloperWebsites", fields: [developerId], references: [id], onDelete: Cascade)

  // This is only optional beacuse of the onboarding
  clientId String?
  client   User?   @relation("ClientWebsites", fields: [clientId], references: [id], onDelete: SetNull)

  feedback Feedback[]
  invites  Invite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([developerId, url])
  @@index([developerId])
  @@index([clientId])
}

model Feedback {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  status      FeedbackStatus   @default(NEW)
  type        FeedbackType     @default(IMPROVEMENT)
  priority    FeedbackPriority @default(LOW)
  title       String
  description String?
  pageUrl     String

  screenshotKey String

  browser        String?
  browserVersion String?
  device         String?
  os             String?
  viewport       String?
  timestamp      DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId])
  @@index([authorId])
}

model Invite {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  email      String
  token      String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime?
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([websiteId])
  @@index([email])
}

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  sessions  Session[]
  accounts  Account[]

  // Better Auth additional fields
  hasCompletedOnboarding Boolean? @default(false)
  role                   String?  @default("developer")
  emailNotifications     Boolean  @default(true)

  // Reviseo relations
  developerWebsites Website[]  @relation("DeveloperWebsites")
  clientWebsites    Website[]  @relation("ClientWebsites")
  feedback          Feedback[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}
