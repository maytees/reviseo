// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "./generated/client"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

// =====================
// Reviseo core models
// =====================

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum FeedbackType {
  BUG
  IMPROVEMENT
  TEXT_EDIT
  STYLE_EDIT
}

// Per-edit lifecycle inside a TEXT_EDIT feedback: the developer marks each
// suggestion applied or rejected independently.
enum TextEditStatus {
  PENDING
  APPLIED
  REJECTED
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Website {
  id        String @id @default(cuid())
  name      String
  url       String
  projectId String @unique @default(uuid())

  widgetInstalled Boolean   @default(false)
  verifiedAt      DateTime?

  screenshotKey String?

  // The workspace (agency or personal) that owns this website.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The member who created the website (notification target).
  developerId String
  developer   User   @relation("DeveloperWebsites", fields: [developerId], references: [id], onDelete: Cascade)

  // This is only optional beacuse of the onboarding
  clientId String?
  client   User?   @relation("ClientWebsites", fields: [clientId], references: [id], onDelete: SetNull)

  feedback Feedback[]
  invites  Invite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, url])
  @@index([organizationId])
  @@index([developerId])
  @@index([clientId])
}

model Feedback {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  status      FeedbackStatus   @default(NEW)
  type        FeedbackType     @default(IMPROVEMENT)
  priority    FeedbackPriority @default(LOW)
  title       String
  description String?
  pageUrl     String

  // Optional: TEXT_EDIT feedback has no screenshot.
  screenshotKey String?

  textEdits  TextEdit[]
  styleEdits StyleEdit[]

  browser        String?
  browserVersion String?
  device         String?
  os             String?
  viewport       String?
  timestamp      DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId])
  @@index([authorId])
}

// One suggested copy change captured by the widget's text-edit tool. A
// TEXT_EDIT feedback groups the batch a client submitted in one session.
model TextEdit {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  // Best-effort CSS selector for locating the element; originalText is the
  // reliable fallback when host markup changes.
  selector      String
  elementTag    String?
  originalText  String
  suggestedText String
  pageUrl       String

  status TextEditStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([feedbackId])
}

// One element's suggested style changes from the widget's style-edit tool.
// A STYLE_EDIT feedback groups the batch a client submitted in one session.
model StyleEdit {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  selector   String
  elementTag String?
  pageUrl    String

  // [{ property, before, after }] — longhand CSS properties only
  changes Json

  status TextEditStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([feedbackId])
}

model Invite {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  email      String
  token      String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime?
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([websiteId])
  @@index([email])
}

// enum SubscriptionStatus {
//   incomplete
//   incomplete_expired
//   trailing
//   active
//   past_due
//   canceled
//   unpaid
// }

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  polarSubId String @unique
  planId     String
  // status     SubscriptionStatus
  status     String

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  sessions  Session[]
  accounts  Account[]

  // Better Auth additional fields
  hasCompletedOnboarding Boolean? @default(false)
  role                   String?  @default("developer")
  emailNotifications     Boolean  @default(true)

  // Reviseo relations
  developerWebsites Website[]     @relation("DeveloperWebsites")
  clientWebsites    Website[]     @relation("ClientWebsites")
  feedback          Feedback[]
  subscription      Subscription?

  // Organization (agency workspace) relations
  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

// =====================
// Better Auth organization plugin (agency workspaces)
// =====================

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime

  members     Member[]
  invitations Invitation[]
  websites    Website[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "owner" | "admin" | "member"
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  // "pending" | "accepted" | "rejected" | "canceled"
  status         String       @default("pending")
  expiresAt      DateTime
  // Better Auth ≥1.6 writes this on invite creation
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  // Organization plugin: the org this session is currently acting in
  activeOrganizationId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Article {
  id               String   @id
  title            String
  slug             String   @unique
  content_markdown String
  content_html     String
  meta_description String
  image_url        String?
  tags             String[] // Postgres supports arrays
  created_at       DateTime
  received_at      DateTime @default(now())
}
